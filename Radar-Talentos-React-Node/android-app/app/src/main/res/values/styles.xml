<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema Nativo Edge-to-Edge (Barras de status e navegação 100% transparentes + cutout shortEdges) -->
    <style name="RadarEdgeToEdgeTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/radar_bg</item>
        <item name="android:colorBackground">@color/radar_bg</item>
        <item name="android:statusBarColor">@color/radar_transparent</item>
        <item name="android:navigationBarColor">@color/radar_transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
